{
    "preset": "laravel",
    "rules": {
        "array_syntax": {
            "syntax": "short"
        },
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "single_quote": true,
        "blank_line_before_statement": {
            "statements": [
                "return",
                "throw",
                "try"
            ]
        },
        "concat_space": {
            "spacing": "one"
        },
        "trailing_comma_in_multiline": {
            "elements": [
                "arrays",
                "arguments"
            ]
        }
    }
}