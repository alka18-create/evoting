APP_NAME="E-Voting Sekolah"
APP_ENV=production
APP_KEY=
# Prod wajib false (jangan bocorkan stack trace). Local boleh true.
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Prod: info/warning agar log tidak membocorkan data sensitif.
LOG_LEVEL=info

# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=evoting
DB_USERNAME=evoting
# P1-06: JANGAN pakai nilai ini di prod. Generate acak: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME__generate__openssl_rand_base64_24

# ------------------------------------------------------------------
# Session
# ------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# P1-02: enkripsi payload session di rest. Biarkan true bahkan di local.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Prod (HTTPS) wajib true. Local HTTP biarkan false agar login tidak rusak.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------
# Cache / Queue / Broadcasting (Redis)
# ------------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=evoting_

BROADCAST_CONNECTION=reverb

QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------
# Laravel Reverb (realtime monitoring)
# ------------------------------------------------------------------
REVERB_APP_ID=evoting-local
REVERB_APP_KEY=evoting-local-key
REVERB_APP_SECRET=evoting-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SSL_VERIFY=0

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------------------------------
# Filesystem
# ------------------------------------------------------------------
FILESYSTEM_DISK=local
FILESYSTEM_PRIVATE_DISK=private

# ------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@evoting.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# AWS (opsional, untuk storage jarak jauh)
# ------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------
# Konfigurasi khusus E-Voting
# ------------------------------------------------------------------
VOTING_IDEMPOTENCY_TTL=3600
VOTING_CREDENTIAL_LENGTH=8
VOTING_CREDENTIAL_ALPHABET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789

# P1-03: lockout progresif login voter (melengkapi throttle 5/mnt).
VOTER_LOCKOUT_MAX_ATTEMPTS=10
VOTER_LOCKOUT_DECAY_MINUTES=15

# P1-02: batas idle sesi voter (menit). Terpisah dari SESSION_LIFETIME
# agar sesi admin tidak ikut pendek.
VOTER_SESSION_LIFETIME=30

SUPER_ADMIN_EMAIL=superadmin@evoting.local
# P1-06: wajib diganti saat setup prod. Min 12 char, unik per instalasi.
SUPER_ADMIN_PASSWORD=CHANGE_ME__min_12_char_unik

# P1-05: retensi audit log (hari). Default 1095 (3 thn) sesuai Threat Model §41.
AUDIT_RETENTION_DAYS=1095

VITE_APP_NAME="${APP_NAME}"